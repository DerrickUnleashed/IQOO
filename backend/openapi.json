              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/buildings/{building_id}/accessibility": {
      "get": {
        "tags": [
          "buildings"
        ],
        "summary": "Get Building Accessibility",
        "operationId": "get_building_accessibility_api_v1_buildings__building_id__accessibility_get",
        "parameters": [
          {
            "name": "building_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Building Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildingAccessibilityOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/perception/analyze": {
      "post": {
        "tags": [
          "perception"
        ],
        "summary": "Analyze Frame",
        "operationId": "analyze_frame_api_v1_perception_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeFrameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeFrameResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scene/update": {
      "post": {
        "tags": [
          "perception"
        ],
        "summary": "Update Scene",
        "description": "Apply detections to the stateful scene graph for a session.",
        "operationId": "update_scene_api_v1_scene_update_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SceneUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SceneUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/routes/calculate": {
      "post": {
        "tags": [
          "routes"
        ],
        "summary": "Calculate Route",
        "description": "Calculate an accessibility-aware route for the user's profile.",
        "operationId": "calculate_route_api_v1_routes_calculate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Route"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/routes/replan": {
      "post": {
        "tags": [
          "routes"
        ],
        "summary": "Replan Route",
        "description": "Replan from the current position when the route is blocked.",
        "operationId": "replan_route_api_v1_routes_replan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Route"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/verification/check": {
      "post": {
        "tags": [
          "verification"
        ],
        "summary": "Check Verification",
        "operationId": "check_verification_api_v1_verification_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assistant/query": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Assistant Query",
        "description": "Handle a user's voice/text command.\n\nThe LangGraph agent gets wired here in the agent milestone. Until\nthen a deterministic fallback provides graceful degraded responses.",
        "operationId": "assistant_query_api_v1_assistant_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ping": {
      "get": {
        "summary": "Ping",
        "description": "Minimal endpoint for connectivity checks from the mobile app.",
        "operationId": "ping_api_v1_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ping Api V1 Ping Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessibilityProfile": {
        "properties": {
          "mobility": {
            "type": "string",
            "enum": [
              "none",
              "temporary_mobility",
              "wheelchair",
              "walking_aid",
              "cane"
            ],
            "title": "Mobility",
            "default": "none"
          },
          "vision": {
            "type": "string",
            "enum": [
              "none",
              "temporary_vision",
              "low_vision",
              "blind"
            ],
            "title": "Vision",
            "default": "none"
          },
          "hearing": {
            "type": "string",
            "enum": [
              "none",
              "hearing_aid",
              "deaf"
            ],
            "title": "Hearing",
            "default": "none"
          },
          "guidance_style": {
            "type": "string",
            "enum": [
              "concise",
              "normal",
              "detailed"
            ],
            "title": "Guidance Style",
            "default": "normal"
          },
          "walking_speed_mps": {
            "type": "number",
            "maximum": 4.0,
            "exclusiveMinimum": 0.0,
            "title": "Walking Speed Mps",
            "default": 1.2
          },
          "max_comfortable_distance_m": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 10.0,
            "title": "Max Comfortable Distance M",
            "default": 100
          },
          "cognitive_load_preference": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Cognitive Load Preference",
            "default": 1
          }
        },
        "type": "object",
        "title": "AccessibilityProfile",
        "description": "Recommendations are derived from this profile."
      },
      "Action": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "default": "instruction"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 0.5
          },
          "haptics": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Haptics"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "Action",
        "description": "The recommended next action \u2014 the core product output."
      },
      "AnalyzeFrameRequest": {
        "properties": {
          "frame_id": {
            "type": "string",
            "title": "Frame Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "encoded_frame": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Encoded Frame"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "frame_id",
          "session_id"
        ],
        "title": "AnalyzeFrameRequest",
        "description": "A single frame sent for analysis (frames are throttled client-side)."
      },
      "AnalyzeFrameResponse": {
        "properties": {
          "frame_id": {
            "type": "string",
            "title": "Frame Id"
          },
          "detections": {
            "items": {
              "$ref": "#/components/schemas/Detection"
            },
            "type": "array",
            "title": "Detections"
          },
          "scene_summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Scene Summary"
          },
          "processing_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Processing Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "frame_id",
          "detections"
        ],
        "title": "AnalyzeFrameResponse",
        "description": "Structured result; raw frames are never stored."
      },
      "AssistantQuery": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AssistantQuery",
        "description": "A voice-text command from the user (Whisper transcript)."
      },
      "AssistantResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Action"
              },
              {
                "type": "null"
              }
            ]
          },
          "detections": {
            "items": {
              "$ref": "#/components/schemas/SceneObject"
            },
            "type": "array",
            "title": "Detections"
          },
          "route_change": {
            "type": "boolean",
            "title": "Route Change",
            "default": false
          },
          "debug": {
            "additionalProperties": true,
            "type": "object",
            "title": "Debug"
          }
        },
        "type": "object",
        "required": [
          "reply"
        ],
        "title": "AssistantResponse",
        "description": "Natural-language response, always grounded in structured state."
      },
      "BuildingAccessibilityOut": {
        "properties": {
          "building_id": {
            "type": "integer",
            "title": "Building Id"
          },
          "accessible_entrances": {
            "items": {
              "$ref": "#/components/schemas/Location"
            },
            "type": "array",
            "title": "Accessible Entrances"
          },
          "elevators": {
            "type": "integer",
            "title": "Elevators",
            "default": 0
          },
          "ramps": {
            "type": "integer",
            "title": "Ramps",
            "default": 0
          },
          "wheelchair_accessible_floors": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Wheelchair Accessible Floors"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "building_id"
        ],
        "title": "BuildingAccessibilityOut"
      },
      "BuildingOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "has_floor_plan": {
            "type": "boolean",
            "title": "Has Floor Plan",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "BuildingOut"
      },
      "Detection": {
        "properties": {
          "object_type": {
            "type": "string",
            "title": "Object Type"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "estimated_distance_m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Distance M"
          },
          "distance_confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Confidence"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction",
            "default": "front"
          },
          "bbox": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 4,
                "minItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "detector"
          },
          "attributes": {
            "additionalProperties": true,
            "type": "object",
            "title": "Attributes"
          }
        },
        "type": "object",
        "required": [
          "object_type",
          "confidence"
        ],
        "title": "Detection",
        "description": "A single perceived object, fused from detection + depth + OCR."
      },
      "Direction": {
        "type": "string",
        "enum": [
          "front",
          "left",
          "right",
          "behind"
