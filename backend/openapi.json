              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BuildingOut"
                  },
                  "type": "array",
                  "title": "Response List Buildings Api V1 Buildings Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/buildings/{building_id}": {
      "get": {
        "tags": [
