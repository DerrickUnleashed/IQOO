        ],
        "summary": "Get Building",
        "operationId": "get_building_api_v1_buildings__building_id__get",
        "parameters": [
          {
            "name": "building_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Building Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildingOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
