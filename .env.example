# AccessCopilot Environment Configuration
# Copy this file to .env and fill in your values

# Groq API (LLM reasoning). Free key: https://console.groq.com/keys
# Leave GROQ_API_KEY blank to run with deterministic (non-LLM) reasoning.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_S=8.0

# Database
# POSTGRES_HOST_PORT is the host port the db container publishes. Change it
# (e.g. 5433) if a PostgreSQL server is already installed locally on 5432,
# and keep the port in DATABASE_URL in sync.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/accesscopilot
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=accesscopilot

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Perception
# auto     - real inference when YOLO weights are present, scripted otherwise
# real     - real inference only; degrades visibly if weights are missing
# scripted - deterministic scenario playback, no inference (demos and tests)
# off      - perception disabled
PERCEPTION_MODE=auto
YOLO_WEIGHTS=yolo/yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
# stairs_ramp | stairs_elevator | blocked_corridor | room_navigation | outdoor_crossing
DEMO_SCENARIO=stairs_ramp

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=accesscopilot

# Firebase (optional, for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Maps (optional)
OPENROUTE_SERVICE_KEY=
