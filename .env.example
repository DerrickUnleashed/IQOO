# AccessCopilot Environment Configuration
# Copy this file to .env and fill in your values

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/accesscopilot
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=accesscopilot

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=accesscopilot

# Firebase (optional, for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Maps (optional)
OPENROUTE_SERVICE_KEY=
